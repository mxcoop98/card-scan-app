{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/((?!_expo|assets|favicon\\.ico|robots\\.txt).*)", "destination": "/index.html" }
  ]
}
